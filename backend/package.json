{
  "name": "college-erp-backend",
  "version": "3.0.1",
  "description": "Next-generation College ERP System Backend API with AI intelligence, real-time features, and modern architecture",
  "main": "src/server.js",
  "author": {
    "name": "Adarsh",
    "email": "contact@studenterp.dev",
    "url": "https://github.com/HeyAdarsh14"
  },
  "homepage": "https://github.com/HeyAdarsh14/StudentErp",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeyAdarsh14/StudentErp.git"
  },
  "bugs": {
    "url": "https://github.com/HeyAdarsh14/StudentErp/issues"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:debug": "nodemon --inspect src/server.js",
    "dev:watch": "nodemon src/server.js --watch src --ext js,json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "eslint --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "health:check": "curl -f http://localhost:5000/health || exit 1",
    "metrics:view": "curl -s http://localhost:5000/metrics | json",
    "env:validate": "node -e \"require('./src/config/env')\"",
    "setup:verify": "node setup-verify.js",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "db:backup": "node scripts/backup-database.js",
    "logs:view": "tail -f logs/app.log",
    "logs:error": "tail -f logs/error.log",
    "security:audit": "npm audit && node scripts/security-check.js",
    "docker:build": "docker build -t college-erp-backend .",
    "docker:run": "docker run -p 5000:5000 college-erp-backend",
    "prod:check": "npm run lint && npm run env:validate && npm run test",
    "prod:deploy": "npm run prod:check && npm run docker:build",
    "monitor:performance": "node scripts/performance-monitor.js",
    "clean": "rm -rf node_modules dist logs/*.log && npm install",
    "postinstall": "npm run setup:verify"
  },
  "keywords": [
    "erp",
    "college-management",
    "mern",
    "education",
    "nodejs",
    "express",
    "mongodb",
    "jwt-auth",
    "socket-io",
    "ai-powered",
    "student-management",
    "academic-system",
    "lms",
    "placement-management",
    "fee-management"
  ],
  "author": {
    "name": "Adarsh",
    "email": "contact@studenterp.dev",
    "url": "https://github.com/HeyAdarsh14"
  },
  "contributors": [
    "Development Team <dev@studenterp.dev>"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "openai": "^6.21.0",
    "pdfkit": "^0.13.0",
    "razorpay": "^2.9.2",
    "socket.io": "^4.6.0",
    "stripe": "^14.10.0",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
